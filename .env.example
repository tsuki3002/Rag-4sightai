# --- LLM (any OpenAI-compatible endpoint) ---
# Groq (free tier): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=openai/gpt-oss-120b

# OpenRouter alternative (free models end in ":free"): https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Follow-up questions: how many recent messages are sent along, and an optional (cheaper/faster) model
# for rewriting follow-ups into standalone search queries, e.g. openai/gpt-oss-20b on Groq
HISTORY_MESSAGES=6
REWRITE_MODEL=openai/gpt-oss-20b

# Images: local OCR always runs (free). Set VISION_MODEL to also have a vision LLM describe diagrams/charts
# during ingest (uses LLM_BASE_URL/LLM_API_KEY unless VISION_BASE_URL/VISION_API_KEY are set).
# Groq's image-capable model: qwen/qwen3.8-27b  (each image costs ~2k input tokens)
# VISION_MODEL=qwen/qwen3.8-27b

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_PATH=storage/qdrant
# Set QDRANT_URL (and QDRANT_API_KEY) to use a Qdrant server / Qdrant Cloud instead of local files
# QDRANT_URL=
# QDRANT_API_KEY=
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

# Search: "hybrid" = meaning (dense vectors) + exact keywords (BM25); "dense" = meaning only
SEARCH_MODE=hybrid
# Reranker re-scores the top RERANK_CANDIDATES chunks and decides relevance. Empty = off (then MIN_SCORE gates).
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=12
RERANK_MAX_WORDS=128
MIN_RERANK_SCORE=-7.0
TOP_K=5
MAX_CHUNKS_PER_DOC=2
MIN_SCORE=0.62

# Log questions/retrieval/answers + 👍/👎 feedback to storage/logs.db (review: python -m scripts.feedback)
LOG_INTERACTIONS=true

# Set to enable the document upload endpoint (send as X-Admin-Token header)
# ADMIN_TOKEN=
